FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir temporalio opencv-python-headless mediapipe==0.10.14 onnxruntime numpy

COPY worker_face.py .

CMD ["python", "-u", "worker_face.py"]