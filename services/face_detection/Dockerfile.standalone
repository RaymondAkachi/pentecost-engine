FROM python:3.10-slim

# Install system dependencies required by OpenCV and MediaPipe
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python packages (No Temporal dependencies!)
RUN pip install --no-cache-dir opencv-python-headless mediapipe==0.10.14 onnxruntime numpy

COPY standalone_test.py .

# Run the test script
CMD ["python", "-u", "standalone_test.py"]