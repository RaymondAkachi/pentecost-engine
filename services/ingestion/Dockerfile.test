# Use a valid, high version of Go (Alpine based)
FROM golang:1.23-alpine

# 1. Install System Dependencies
# We need python3 for yt-dlp, ffmpeg for processing, and build-base for CGO
RUN apk update && apk add --no-cache \
    ffmpeg \
    python3 \
    curl \
    build-base \
    git

# 2. Install yt-dlp (Essential for resolving live YouTube URLs)
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp

WORKDIR /app

# 3. Cache Go Modules
COPY go.mod go.sum ./
RUN go mod download

# 4. Copy Source Code
COPY . .

# FIX: Ensure go.mod is consistent with the code changes before building
RUN go mod tidy

# 5. Run the Service (Not just tests)
# We build it to ensure compilation passes
RUN go build -o ingestion-service main.go

# Default command runs the integration test which acts as a viewer
CMD ["go", "test", "-v", "-timeout", "300s", "integration_test.go", "main.go"]